// RUN: split-file %s %t
// RUN: not cir-tile-translate %t/missing.cir 2>&1 | FileCheck %s --check-prefix=MISSING
// RUN: not cir-tile-translate %t/unsupported.cir 2>&1 | FileCheck %s --check-prefix=LOWERING

//--- missing.cir
module {
  cir.func @ordinary() {
    cir.return
  }
}
// MISSING: contains no cir_tile.v1.kernel function

//--- unsupported.cir
module {
  cir.func @kernel() [#cir.annotation<"cir_tile.v1.kernel">] {
    cir.call @kernel() : () -> ()
    cir.return
  }
}
// LOWERING: lowering for annotation 'cir_tile.v1.kernel' is not implemented
