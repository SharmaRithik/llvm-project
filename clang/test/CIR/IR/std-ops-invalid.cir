// RUN: cir-opt %s -verify-diagnostics -split-input-file

!s8i = !cir.int<s, 8>
!s32i = !cir.int<s, 32>

module {
  cir.func @bad_find(%f: !cir.ptr<!s8i>, %l: !cir.ptr<!s8i>, %v: !cir.ptr<!s8i>) -> !s32i {
    // expected-error@below {{'cir.std.find' op failed to verify that all of {first, last, result} have same type}}
    %0 = cir.std.find(%f : !cir.ptr<!s8i>, %l : !cir.ptr<!s8i>, %v : !cir.ptr<!s8i>, @x) -> !s32i
    cir.return %0 : !s32i
  }
}

// -----

!s8i = !cir.int<s, 8>
!s32i = !cir.int<s, 32>
!closure = !cir.struct<class "Closure" {data !s8i}>

module {
  cir.func @bad_find_if(%f: !cir.ptr<!s8i>, %l: !cir.ptr<!s8i>, %p: !closure) -> !s32i {
    // expected-error@below {{'cir.std.find_if' op failed to verify that all of {first, last, result} have same type}}
    %0 = cir.std.find_if(%f : !cir.ptr<!s8i>, %l : !cir.ptr<!s8i>, %p : !closure, @x) -> !s32i
    cir.return %0 : !s32i
  }
}

// -----

!s8i = !cir.int<s, 8>
!s32i = !cir.int<s, 32>
!closure = !cir.struct<class "Closure" {data !s8i}>

module {
  cir.func @bad_find_if_not(%f: !cir.ptr<!s8i>, %l: !cir.ptr<!s8i>, %p: !closure) -> !s32i {
    // expected-error@below {{'cir.std.find_if_not' op failed to verify that all of {first, last, result} have same type}}
    %0 = cir.std.find_if_not(%f : !cir.ptr<!s8i>, %l : !cir.ptr<!s8i>, %p : !closure, @x) -> !s32i
    cir.return %0 : !s32i
  }
}

// -----

!s8i = !cir.int<s, 8>
!s32i = !cir.int<s, 32>

module {
  cir.func @bad_equal_iterators(%f: !cir.ptr<!s8i>, %l: !cir.ptr<!s32i>, %s: !cir.ptr<!s8i>) -> !cir.bool {
    // expected-error@below {{'cir.std.equal' op failed to verify that all of {first1, last1} have same type}}
    %0 = cir.std.equal(%f : !cir.ptr<!s8i>, %l : !cir.ptr<!s32i>, %s : !cir.ptr<!s8i>, @x) -> !cir.bool
    cir.return %0 : !cir.bool
  }
}

// -----

!s8i = !cir.int<s, 8>
!s32i = !cir.int<s, 32>

module {
  cir.func @bad_equal_result(%f: !cir.ptr<!s8i>, %l: !cir.ptr<!s8i>, %s: !cir.ptr<!s8i>) -> !s32i {
    // expected-error@below {{'cir.std.equal' op result #0 must be CIR bool type}}
    %0 = cir.std.equal(%f : !cir.ptr<!s8i>, %l : !cir.ptr<!s8i>, %s : !cir.ptr<!s8i>, @x) -> !s32i
    cir.return %0 : !s32i
  }
}

// -----

!s8i = !cir.int<s, 8>
!s32i = !cir.int<s, 32>
!badclosure = !cir.struct<class "BadClosure" {data !s8i}>

module {
  cir.func @bad_equal_pred_iterators(%f: !cir.ptr<!s8i>, %l: !cir.ptr<!s32i>, %s: !cir.ptr<!s8i>, %p: !badclosure) -> !cir.bool {
    // expected-error@below {{'cir.std.equal_pred' op failed to verify that all of {first1, last1} have same type}}
    %0 = cir.std.equal_pred(%f : !cir.ptr<!s8i>, %l : !cir.ptr<!s32i>, %s : !cir.ptr<!s8i>, %p : !badclosure, @x) -> !cir.bool
    cir.return %0 : !cir.bool
  }
}

// -----

!s8i = !cir.int<s, 8>
!s32i = !cir.int<s, 32>
!badpair_m = !cir.struct<class "BadPairM" {data !cir.ptr<!s8i>, data !cir.ptr<!s8i>}>

module {
  cir.func @bad_mismatch_iterators(%f: !cir.ptr<!s8i>, %l: !cir.ptr<!s32i>, %s: !cir.ptr<!s8i>) -> !badpair_m {
    // expected-error@below {{'cir.std.mismatch' op failed to verify that all of {first1, last1} have same type}}
    %0 = cir.std.mismatch(%f : !cir.ptr<!s8i>, %l : !cir.ptr<!s32i>, %s : !cir.ptr<!s8i>, @x) -> !badpair_m
    cir.return %0 : !badpair_m
  }
}

// -----

!s8i = !cir.int<s, 8>
!s32i = !cir.int<s, 32>
!cpo = !cir.struct<class "std::__1::ranges::__find" {pad !s8i}>
!identity = !cir.struct<class "std::__1::identity" {pad !s8i}>

module {
  cir.func @bad_ranges_find(%c: !cir.ptr<!cpo>, %f: !cir.ptr<!s8i>, %l: !cir.ptr<!s8i>, %v: !cir.ptr<!s8i>, %p: !identity) -> !s32i {
    // expected-error@below {{'cir.std.ranges.find' op failed to verify that all of {first, last, result} have same type}}
    %0 = cir.std.ranges.find(%c : !cir.ptr<!cpo>, %f : !cir.ptr<!s8i>, %l : !cir.ptr<!s8i>, %v : !cir.ptr<!s8i>, %p : !identity, @x) -> !s32i
    cir.return %0 : !s32i
  }
}

// -----

!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>

module {
  cir.func @bad_strlen(%s: !cir.ptr<!s32i>) -> !u64i {
    // expected-error@below {{'cir.std.strlen' op operand #0 must be pointer to 8-bit character type}}
    %0 = cir.std.strlen(%s : !cir.ptr<!s32i>, @strlen) -> !u64i
    cir.return %0 : !u64i
  }
}

// -----

!bi8 = !cir.int<s, 8, bitint>
!u64i = !cir.int<u, 64>

module {
  cir.func @bad_strlen_bitint_arg(%s: !cir.ptr<!bi8>) -> !u64i {
    // expected-error@below {{'cir.std.strlen' op operand #0 must be pointer to 8-bit character type}}
    %0 = cir.std.strlen(%s : !cir.ptr<!bi8>, @strlen) -> !u64i
    cir.return %0 : !u64i
  }
}

// -----

!s8i = !cir.int<s, 8>
!s64i = !cir.int<s, 64>

module {
  cir.func @bad_strlen_signed_result(%s: !cir.ptr<!s8i>) -> !s64i {
    // expected-error@below {{'cir.std.strlen' op result #0 must be fundamental unsigned integer type}}
    %0 = cir.std.strlen(%s : !cir.ptr<!s8i>, @strlen) -> !s64i
    cir.return %0 : !s64i
  }
}

// -----

!s8i = !cir.int<s, 8>
!s32i = !cir.int<s, 32>

module {
  cir.func @bad_search(%f1: !cir.ptr<!s8i>, %l1: !cir.ptr<!s8i>,
                       %f2: !cir.ptr<!s8i>, %l2: !cir.ptr<!s32i>) -> !cir.ptr<!s8i> {
    // expected-error@below {{'cir.std.search' op failed to verify that all of {first2, last2} have same type}}
    %0 = cir.std.search(%f1 : !cir.ptr<!s8i>, %l1 : !cir.ptr<!s8i>,
                        %f2 : !cir.ptr<!s8i>, %l2 : !cir.ptr<!s32i>,
                        @x) -> !cir.ptr<!s8i>
    cir.return %0 : !cir.ptr<!s8i>
  }
}
