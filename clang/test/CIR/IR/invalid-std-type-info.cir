// RUN: cir-opt %s -verify-diagnostics -split-input-file

!s8i = !cir.int<s, 8>

// expected-error@below {{std_type_info requires a complete identified record}}
!bad = !cir.struct<{data !cir.ptr<!s8i>}, std_type_info = #cir.std_type_info<"std::vector", !s8i, begin[0], end[0]>>

// -----

!s8i = !cir.int<s, 8>

// expected-error@below {{std_type_info requires a complete identified record}}
!bad = !cir.struct<"incomplete_carrier" incomplete, std_type_info = #cir.std_type_info<"std::vector", !s8i, begin[0], end[0]>>

// -----

!s8i = !cir.int<s, 8>

!first = !cir.struct<"conflicted" {data !cir.ptr<!s8i>, data !cir.ptr<!s8i>}, std_type_info = #cir.std_type_info<"std::vector", !s8i, begin[0], end[1]>>
// expected-error@below {{std_type_info contradicts an earlier spelling of the same record}}
!second = !cir.struct<"conflicted" {data !cir.ptr<!s8i>, data !cir.ptr<!s8i>}, std_type_info = #cir.std_type_info<"std::vector", !s8i, begin[1], end[0]>>
