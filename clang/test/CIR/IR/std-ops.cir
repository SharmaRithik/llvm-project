// RUN: cir-opt %s | FileCheck %s

!s8i = !cir.int<s, 8>
!u64i = !cir.int<u, 64>
!closure = !cir.struct<class "Closure" {data !s8i}>
!cpo = !cir.struct<class "std::__1::ranges::__find" {pad !s8i}>
!identity = !cir.struct<class "std::__1::identity" {pad !s8i}>
!vec = !cir.struct<class "std::__1::vector<char>" {data !cir.ptr<!s8i>, data !cir.ptr<!s8i>}, std_type_info = #cir.std_type_info<"std::vector", !s8i, begin[0], end[1]>>
// CHECK: !cir.struct<class "std::__1::vector<char>" {data !cir.ptr<!s8i>, data !cir.ptr<!s8i>}, std_type_info = #cir.std_type_info<"std::vector", !s8i, begin[0], end[1]>>

module {
  cir.func private @_ZSt4find(!cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!s8i>) -> !cir.ptr<!s8i>
  cir.func private @_ZSt6searchIPcS0_ET_S1_S1_T0_S2_(!cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!s8i>) -> !cir.ptr<!s8i>
  cir.func private @_ZSt7find_if(!cir.ptr<!s8i>, !cir.ptr<!s8i>, !closure) -> !cir.ptr<!s8i>
  cir.func private @_ZSt11find_if_not(!cir.ptr<!s8i>, !cir.ptr<!s8i>, !closure) -> !cir.ptr<!s8i>
  cir.func private @_ZNKSt3__16ranges6__findcl(!cir.ptr<!cpo>, !cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!s8i>, !identity) -> !cir.ptr<!s8i>
  cir.func private @_ZNKSt3__16ranges6__findclR(!cir.ptr<!cpo>, !cir.ptr<!vec>, !cir.ptr<!s8i>, !identity) -> !cir.ptr<!s8i>
  cir.func private @strlen(!cir.ptr<!s8i>) -> !u64i

  cir.func @test_find(%first: !cir.ptr<!s8i>, %last: !cir.ptr<!s8i>, %value: !cir.ptr<!s8i>) -> !cir.ptr<!s8i> {
    %0 = cir.std.find(%first : !cir.ptr<!s8i>, %last : !cir.ptr<!s8i>, %value : !cir.ptr<!s8i>, @_ZSt4find) -> !cir.ptr<!s8i>
    cir.return %0 : !cir.ptr<!s8i>
  }
  // CHECK: cir.func @test_find(%[[FIRST:.*]]: !cir.ptr<!s8i>, %[[LAST:.*]]: !cir.ptr<!s8i>, %[[VALUE:.*]]: !cir.ptr<!s8i>)
  // CHECK: cir.std.find(%[[FIRST]] : !cir.ptr<!s8i>, %[[LAST]] : !cir.ptr<!s8i>, %[[VALUE]] : !cir.ptr<!s8i>, @_ZSt4find) -> !cir.ptr<!s8i>


  cir.func @test_search(%first1: !cir.ptr<!s8i>, %last1: !cir.ptr<!s8i>, %first2: !cir.ptr<!s8i>, %last2: !cir.ptr<!s8i>) -> !cir.ptr<!s8i> {
    %0 = cir.std.search(%first1 : !cir.ptr<!s8i>, %last1 : !cir.ptr<!s8i>, %first2 : !cir.ptr<!s8i>, %last2 : !cir.ptr<!s8i>, @_ZSt6searchIPcS0_ET_S1_S1_T0_S2_) -> !cir.ptr<!s8i>
    cir.return %0 : !cir.ptr<!s8i>
  }
  // CHECK: cir.func @test_search(%[[FIRST1:.*]]: !cir.ptr<!s8i>, %[[LAST1:.*]]: !cir.ptr<!s8i>, %[[FIRST2:.*]]: !cir.ptr<!s8i>, %[[LAST2:.*]]: !cir.ptr<!s8i>)
  // CHECK: cir.std.search(%[[FIRST1]] : !cir.ptr<!s8i>, %[[LAST1]] : !cir.ptr<!s8i>, %[[FIRST2]] : !cir.ptr<!s8i>, %[[LAST2]] : !cir.ptr<!s8i>, @_ZSt6searchIPcS0_ET_S1_S1_T0_S2_) -> !cir.ptr<!s8i>
  cir.func @test_find_if(%first: !cir.ptr<!s8i>, %last: !cir.ptr<!s8i>, %pred: !closure) -> !cir.ptr<!s8i> {
    %0 = cir.std.find_if(%first : !cir.ptr<!s8i>, %last : !cir.ptr<!s8i>, %pred : !closure, @_ZSt7find_if) -> !cir.ptr<!s8i>
    cir.return %0 : !cir.ptr<!s8i>
  }
  // CHECK: cir.func @test_find_if(%[[IFFIRST:.*]]: !cir.ptr<!s8i>, %[[IFLAST:.*]]: !cir.ptr<!s8i>, %[[IFPRED:.*]]: !rec_Closure)
  // CHECK: cir.std.find_if(%[[IFFIRST]] : !cir.ptr<!s8i>, %[[IFLAST]] : !cir.ptr<!s8i>, %[[IFPRED]] : !rec_Closure, @_ZSt7find_if) -> !cir.ptr<!s8i>

  cir.func @test_find_if_not(%first: !cir.ptr<!s8i>, %last: !cir.ptr<!s8i>, %pred: !closure) -> !cir.ptr<!s8i> {
    %0 = cir.std.find_if_not(%first : !cir.ptr<!s8i>, %last : !cir.ptr<!s8i>, %pred : !closure, @_ZSt11find_if_not) -> !cir.ptr<!s8i>
    cir.return %0 : !cir.ptr<!s8i>
  }
  // CHECK: cir.func @test_find_if_not(%[[NOTFIRST:.*]]: !cir.ptr<!s8i>, %[[NOTLAST:.*]]: !cir.ptr<!s8i>, %[[NOTPRED:.*]]: !rec_Closure)
  // CHECK: cir.std.find_if_not(%[[NOTFIRST]] : !cir.ptr<!s8i>, %[[NOTLAST]] : !cir.ptr<!s8i>, %[[NOTPRED]] : !rec_Closure, @_ZSt11find_if_not) -> !cir.ptr<!s8i>

  cir.func @test_ranges_find(%cpo: !cir.ptr<!cpo>, %first: !cir.ptr<!s8i>, %last: !cir.ptr<!s8i>, %value: !cir.ptr<!s8i>, %proj: !identity) -> !cir.ptr<!s8i> {
    %0 = cir.std.ranges.find(%cpo : !cir.ptr<!cpo>, %first : !cir.ptr<!s8i>, %last : !cir.ptr<!s8i>, %value : !cir.ptr<!s8i>, %proj : !identity, @_ZNKSt3__16ranges6__findcl) -> !cir.ptr<!s8i>
    cir.return %0 : !cir.ptr<!s8i>
  }
  // CHECK: cir.func @test_ranges_find(%[[CPO:.*]]: !cir.ptr<!rec_std3A3A__13A3Aranges3A3A__find>, %[[RFIRST:.*]]: !cir.ptr<!s8i>, %[[RLAST:.*]]: !cir.ptr<!s8i>, %[[RVALUE:.*]]: !cir.ptr<!s8i>, %[[PROJ:.*]]: !rec_std3A3A__13A3Aidentity)
  // CHECK: cir.std.ranges.find(%[[CPO]] : !cir.ptr<!rec_std3A3A__13A3Aranges3A3A__find>, %[[RFIRST]] : !cir.ptr<!s8i>, %[[RLAST]] : !cir.ptr<!s8i>, %[[RVALUE]] : !cir.ptr<!s8i>, %[[PROJ]] : !rec_std3A3A__13A3Aidentity, @_ZNKSt3__16ranges6__findcl) -> !cir.ptr<!s8i>

  cir.func @test_ranges_find_range(%cpo: !cir.ptr<!cpo>, %range: !cir.ptr<!vec>, %value: !cir.ptr<!s8i>, %proj: !identity) -> !cir.ptr<!s8i> {
    %0 = cir.std.ranges.find_range(%cpo : !cir.ptr<!cpo>, %range : !cir.ptr<!vec>, %value : !cir.ptr<!s8i>, %proj : !identity, @_ZNKSt3__16ranges6__findclR) -> !cir.ptr<!s8i>
    cir.return %0 : !cir.ptr<!s8i>
  }
  // CHECK: cir.func @test_ranges_find_range(%[[QCPO:.*]]: !cir.ptr<!rec_std3A3A__13A3Aranges3A3A__find>, %[[QRANGE:.*]]: !cir.ptr<!rec_std3A3A__13A3Avector3Cchar3E>, %[[QVALUE:.*]]: !cir.ptr<!s8i>, %[[QPROJ:.*]]: !rec_std3A3A__13A3Aidentity)
  // CHECK: cir.std.ranges.find_range(%[[QCPO]] : !cir.ptr<!rec_std3A3A__13A3Aranges3A3A__find>, %[[QRANGE]] : !cir.ptr<!rec_std3A3A__13A3Avector3Cchar3E>, %[[QVALUE]] : !cir.ptr<!s8i>, %[[QPROJ]] : !rec_std3A3A__13A3Aidentity, @_ZNKSt3__16ranges6__findclR) -> !cir.ptr<!s8i>

  cir.func @test_strlen(%s: !cir.ptr<!s8i>) -> !u64i {
    %0 = cir.std.strlen(%s : !cir.ptr<!s8i>, @strlen) -> !u64i
    cir.return %0 : !u64i
  }
  // CHECK: cir.func @test_strlen(%[[S:.*]]: !cir.ptr<!s8i>)
  // CHECK: cir.std.strlen(%[[S]] : !cir.ptr<!s8i>, @strlen) -> !u64i
}
