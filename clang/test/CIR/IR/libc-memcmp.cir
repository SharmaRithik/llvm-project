// RUN: cir-opt %s --verify-roundtrip | FileCheck %s

!voidptr = !cir.ptr<!cir.void>
!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>
module attributes {cir.int_type_width = 32 : i32,
                   cir.size_type_width = 64 : i32} {
  cir.func @f(%lhs: !voidptr, %rhs: !voidptr, %len: !u64i) -> !s32i {
    // CHECK: cir.libc.memcmp({{.*}}, {{.*}}, {{.*}}) : !cir.ptr<!void>, !cir.ptr<!void>, !u64i -> !s32i
    %result = cir.libc.memcmp(%lhs, %rhs, %len) : !voidptr, !voidptr, !u64i -> !s32i
    cir.return %result : !s32i
  }
}
