// RUN: cir-opt --cir-lib-opt -split-input-file %s | FileCheck %s

!u8i = !cir.int<u, 8>
!wrap = !cir.struct<class "std::__1::__wrap_iter<unsigned char *>" {data !cir.ptr<!u8i>}>
!fat = !cir.struct<class "fat" {data !cir.ptr<!u8i>, data !cir.ptr<!u8i>}>
!union = !cir.union<"iterator_union" {data !cir.ptr<!u8i>}>

module attributes {cir.triple = "x86_64-unknown-linux-gnu",
                   cir.int_type_width = 32 : i32,
                   cir.size_type_width = 64 : i32} {
  cir.func @rewrites_raw(%first1: !cir.ptr<!u8i>, %last1: !cir.ptr<!u8i>, %first2: !cir.ptr<!u8i>) -> !cir.bool {
    %0 = cir.std.equal(%first1 : !cir.ptr<!u8i>, %last1 : !cir.ptr<!u8i>, %first2 : !cir.ptr<!u8i>, @_ZSt5equalIPhS0_EbT_S1_T0_) -> !cir.bool {cir.narrow_char_params}
    cir.return %0 : !cir.bool
  }
// CHECK-LABEL: cir.func @rewrites_raw
// CHECK-SAME: (%[[FIRST1:.*]]: !cir.ptr<!u8i>, %[[LAST1:.*]]: !cir.ptr<!u8i>, %[[FIRST2:.*]]: !cir.ptr<!u8i>)
// CHECK-NOT: cir.std.equal
// CHECK: %[[EMPTY:.*]] = cir.cmp eq %[[FIRST1]], %[[LAST1]] : !cir.ptr<!u8i>
// CHECK: %[[RESULT:.*]] = cir.ternary(%[[EMPTY]], true {
// CHECK: %[[TRUE:.*]] = cir.const #{{.*}}true
// CHECK: cir.yield %[[TRUE]] : !cir.bool
// CHECK: }, false {
// CHECK: %[[LHS:.*]] = cir.cast bitcast %[[FIRST1]] : !cir.ptr<!u8i> -> !cir.ptr<!void>
// CHECK: %[[RHS:.*]] = cir.cast bitcast %[[FIRST2]] : !cir.ptr<!u8i> -> !cir.ptr<!void>
// CHECK: %[[LEN:.*]] = cir.ptr_diff %[[LAST1]], %[[FIRST1]] : !cir.ptr<!u8i> -> !u64i
// CHECK: %[[CMP:.*]] = cir.libc.memcmp(%[[LHS]], %[[RHS]], %[[LEN]]) : !cir.ptr<!void>, !cir.ptr<!void>, !u64i -> !s32i
// CHECK: %[[ZERO:.*]] = cir.const #cir.int<0> : !s32i
// CHECK: %[[EQUAL:.*]] = cir.cmp eq %[[CMP]], %[[ZERO]] : !s32i
// CHECK: cir.yield %[[EQUAL]] : !cir.bool
// CHECK: }) : (!cir.bool) -> !cir.bool
// CHECK: cir.return %[[RESULT]] : !cir.bool

  cir.func @rewrites_wrapped(%first1: !wrap, %last1: !wrap, %first2: !wrap) -> !cir.bool {
    %0 = cir.std.equal(%first1 : !wrap, %last1 : !wrap, %first2 : !wrap, @_ZSt5equalI4wrapS0_EbT_S1_T0_) -> !cir.bool {cir.narrow_char_params}
    cir.return %0 : !cir.bool
  }
// CHECK-LABEL: cir.func @rewrites_wrapped
// CHECK: %[[WFIRST1:.*]] = cir.extract_member %{{.*}}[0] : !rec_std3A3A__13A3A__wrap_iter3Cunsigned_char_2A3E -> !cir.ptr<!u8i>
// CHECK: %[[WLAST1:.*]] = cir.extract_member %{{.*}}[0] : !rec_std3A3A__13A3A__wrap_iter3Cunsigned_char_2A3E -> !cir.ptr<!u8i>
// CHECK: %[[WFIRST2:.*]] = cir.extract_member %{{.*}}[0] : !rec_std3A3A__13A3A__wrap_iter3Cunsigned_char_2A3E -> !cir.ptr<!u8i>
// CHECK: cir.cmp eq %[[WFIRST1]], %[[WLAST1]]
// CHECK: %[[WLHS:.*]] = cir.cast bitcast %[[WFIRST1]] : !cir.ptr<!u8i> -> !cir.ptr<!void>
// CHECK: %[[WRHS:.*]] = cir.cast bitcast %[[WFIRST2]] : !cir.ptr<!u8i> -> !cir.ptr<!void>
// CHECK: %[[WLEN:.*]] = cir.ptr_diff %[[WLAST1]], %[[WFIRST1]] : !cir.ptr<!u8i> -> !u64i
// CHECK: cir.libc.memcmp(%[[WLHS]], %[[WRHS]], %[[WLEN]])
// CHECK-NOT: cir.std.equal

  cir.func @keeps_unmarked(%first1: !cir.ptr<!u8i>, %last1: !cir.ptr<!u8i>, %first2: !cir.ptr<!u8i>) -> !cir.bool {
    %0 = cir.std.equal(%first1 : !cir.ptr<!u8i>, %last1 : !cir.ptr<!u8i>, %first2 : !cir.ptr<!u8i>, @_ZSt5equalIPhS0_EbT_S1_T0_) -> !cir.bool
    cir.return %0 : !cir.bool
  }
// CHECK-LABEL: cir.func @keeps_unmarked
// CHECK: cir.std.equal
// CHECK-NOT: cir.libc.memcmp

  cir.func @keeps_fat_first(%first1: !fat, %last1: !fat, %first2: !cir.ptr<!u8i>) -> !cir.bool {
    %0 = cir.std.equal(%first1 : !fat, %last1 : !fat, %first2 : !cir.ptr<!u8i>, @fat_equal) -> !cir.bool {cir.narrow_char_params}
    cir.return %0 : !cir.bool
  }
// CHECK-LABEL: cir.func @keeps_fat_first
// CHECK: cir.std.equal
// CHECK-NOT: cir.libc.memcmp

  cir.func @keeps_fat_second(%first1: !wrap, %last1: !wrap, %first2: !fat) -> !cir.bool {
    %0 = cir.std.equal(%first1 : !wrap, %last1 : !wrap, %first2 : !fat, @fat_second_equal) -> !cir.bool {cir.narrow_char_params}
    cir.return %0 : !cir.bool
  }
// CHECK-LABEL: cir.func @keeps_fat_second
// CHECK: cir.std.equal
// CHECK-NOT: cir.libc.memcmp

  cir.func @keeps_union(%first1: !union, %last1: !union, %first2: !cir.ptr<!u8i>) -> !cir.bool {
    %0 = cir.std.equal(%first1 : !union, %last1 : !union, %first2 : !cir.ptr<!u8i>, @union_equal) -> !cir.bool {cir.narrow_char_params}
    cir.return %0 : !cir.bool
  }
// CHECK-LABEL: cir.func @keeps_union
// CHECK: cir.std.equal
// CHECK-NOT: cir.libc.memcmp
}

// -----

!u8i = !cir.int<u, 8>

module attributes {cir.triple = "x86_64-unknown-linux-gnu",
                   cir.int_type_width = 32 : i32,
                   cir.size_type_width = 64 : i32} {
  cir.func @rewrites_half_wrapped(%first1: !cir.struct<class "half" {data !cir.ptr<!u8i>}>, %last1: !cir.struct<class "half" {data !cir.ptr<!u8i>}>, %first2: !cir.ptr<!u8i>) -> !cir.bool {
    %0 = cir.std.equal(%first1 : !cir.struct<class "half" {data !cir.ptr<!u8i>}>, %last1 : !cir.struct<class "half" {data !cir.ptr<!u8i>}>, %first2 : !cir.ptr<!u8i>, @half_equal) -> !cir.bool {cir.narrow_char_params}
    cir.return %0 : !cir.bool
  }
}

// -----

!u8i = !cir.int<u, 8>
!u16i = !cir.int<u, 16>
!bi8 = !cir.int<u, 8, bitint>
!asptr = !cir.ptr<!u8i, target_address_space(1)>
!incomplete = !cir.struct<class "incomplete" incomplete>

module attributes {cir.triple = "x86_64-unknown-linux-gnu",
                   cir.int_type_width = 32 : i32,
                   cir.size_type_width = 64 : i32} {
  cir.func @keeps_call_site_nobuiltin(%first1: !cir.ptr<!u8i>,
                                      %last1: !cir.ptr<!u8i>,
                                      %first2: !cir.ptr<!u8i>) -> !cir.bool {
    %0 = cir.std.equal(%first1 : !cir.ptr<!u8i>, %last1 : !cir.ptr<!u8i>,
         %first2 : !cir.ptr<!u8i>, @equal) -> !cir.bool
         {cir.narrow_char_params, nobuiltin}
    cir.return %0 : !cir.bool
  }

  cir.func @keeps_enclosing_nobuiltin(%first1: !cir.ptr<!u8i>,
                                      %last1: !cir.ptr<!u8i>,
                                      %first2: !cir.ptr<!u8i>) -> !cir.bool
      attributes {nobuiltins = ["memcmp"]} {
    %0 = cir.std.equal(%first1 : !cir.ptr<!u8i>, %last1 : !cir.ptr<!u8i>,
         %first2 : !cir.ptr<!u8i>, @equal) -> !cir.bool
         {cir.narrow_char_params}
    cir.return %0 : !cir.bool
  }

  cir.func builtin @keeps_builtin_marked_function(
      %first1: !cir.ptr<!u8i>, %last1: !cir.ptr<!u8i>,
      %first2: !cir.ptr<!u8i>) -> !cir.bool
      attributes {nobuiltins = ["memcmp"]} {
    %0 = cir.std.equal(%first1 : !cir.ptr<!u8i>, %last1 : !cir.ptr<!u8i>,
         %first2 : !cir.ptr<!u8i>, @equal) -> !cir.bool
         {cir.narrow_char_params}
    cir.return %0 : !cir.bool
  }

  cir.func @keeps_malformed_marker(%first1: !cir.ptr<!u8i>,
                                   %last1: !cir.ptr<!u8i>,
                                   %first2: !cir.ptr<!u8i>) -> !cir.bool {
    %0 = cir.std.equal(%first1 : !cir.ptr<!u8i>, %last1 : !cir.ptr<!u8i>,
         %first2 : !cir.ptr<!u8i>, @equal) -> !cir.bool
         {cir.narrow_char_params = "bad"}
    cir.return %0 : !cir.bool
  }

  cir.func @keeps_address_space(%first1: !asptr, %last1: !asptr,
                                %first2: !asptr) -> !cir.bool {
    %0 = cir.std.equal(%first1 : !asptr, %last1 : !asptr,
         %first2 : !asptr, @equal) -> !cir.bool {cir.narrow_char_params}
    cir.return %0 : !cir.bool
  }

  cir.func @keeps_wide_element(%first1: !cir.ptr<!u16i>,
                               %last1: !cir.ptr<!u16i>,
                               %first2: !cir.ptr<!u16i>) -> !cir.bool {
    %0 = cir.std.equal(%first1 : !cir.ptr<!u16i>,
         %last1 : !cir.ptr<!u16i>, %first2 : !cir.ptr<!u16i>,
         @equal) -> !cir.bool {cir.narrow_char_params}
    cir.return %0 : !cir.bool
  }

  cir.func @keeps_incomplete_iterator(%first1: !incomplete,
                                      %last1: !incomplete,
                                      %first2: !cir.ptr<!u8i>) -> !cir.bool {
    %0 = cir.std.equal(%first1 : !incomplete, %last1 : !incomplete,
         %first2 : !cir.ptr<!u8i>, @equal) -> !cir.bool
         {cir.narrow_char_params}
    cir.return %0 : !cir.bool
  }

  cir.func @keeps_bitint_element(%first1: !cir.ptr<!bi8>,
                                 %last1: !cir.ptr<!bi8>,
                                 %first2: !cir.ptr<!bi8>) -> !cir.bool {
    %0 = cir.std.equal(%first1 : !cir.ptr<!bi8>,
         %last1 : !cir.ptr<!bi8>, %first2 : !cir.ptr<!bi8>,
         @equal) -> !cir.bool {cir.narrow_char_params}
    cir.return %0 : !cir.bool
  }
}

