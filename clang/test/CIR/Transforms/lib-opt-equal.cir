// -----

!u8i = !cir.int<u, 8>
!s64i = !cir.int<s, 64>

module attributes {cir.triple = "x86_64-unknown-linux-gnu",
                   cir.int_type_width = 32 : i32,
                   cir.size_type_width = 64 : i32} {
  cir.global external @buf1 = #cir.zero : !cir.array<!u8i x 8>
  cir.global external @buf2 = #cir.zero : !cir.array<!u8i x 8>

  cir.global external @equal_in_ctor = ctor : !cir.bool {
    %0 = cir.get_global @buf1 : !cir.ptr<!cir.array<!u8i x 8>>
    %1 = cir.cast array_to_ptrdecay %0 :
         !cir.ptr<!cir.array<!u8i x 8>> -> !cir.ptr<!u8i>
    %2 = cir.const #cir.int<8> : !s64i
    %3 = cir.ptr_stride %1, %2 :
         (!cir.ptr<!u8i>, !s64i) -> !cir.ptr<!u8i>
    %4 = cir.get_global @buf2 : !cir.ptr<!cir.array<!u8i x 8>>
    %5 = cir.cast array_to_ptrdecay %4 :
         !cir.ptr<!cir.array<!u8i x 8>> -> !cir.ptr<!u8i>
    %6 = cir.std.equal(%1 : !cir.ptr<!u8i>, %3 : !cir.ptr<!u8i>,
         %5 : !cir.ptr<!u8i>, @equal) -> !cir.bool {cir.narrow_char_params}
    %7 = cir.get_global @equal_in_ctor : !cir.ptr<!cir.bool>
    cir.store %6, %7 : !cir.bool, !cir.ptr<!cir.bool>
  }
}

