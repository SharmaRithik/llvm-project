!u8i = !cir.int<u, 8>
!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>
!voidptr = !cir.ptr<!cir.void>

module attributes {cir.triple = "x86_64-unknown-linux-gnu",
                   cir.int_type_width = 32 : i32,
                   cir.size_type_width = 64 : i32} {
  cir.func @memcmp(%lhs: !voidptr, %rhs: !voidptr,
                   %len: !u64i) -> !s32i {
    %zero = cir.const #cir.int<0> : !s32i
    cir.return %zero : !s32i
  }

  cir.func @shares_compatible_definition(%first1: !cir.ptr<!u8i>,
                                          %last1: !cir.ptr<!u8i>,
                                          %first2: !cir.ptr<!u8i>)
      -> !cir.bool {
    %0 = cir.std.equal(%first1 : !cir.ptr<!u8i>,
         %last1 : !cir.ptr<!u8i>, %first2 : !cir.ptr<!u8i>,
         @equal) -> !cir.bool {cir.narrow_char_params}
    cir.return %0 : !cir.bool
  }
}

