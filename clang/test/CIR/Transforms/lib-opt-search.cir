module attributes {cir.triple = "x86_64-unknown-linux-gnu",
                   cir.int_type_width = 32 : i32,
                   cir.size_type_width = 64 : i32,
                   cir.wchar_type_width = 32 : i32} {
  cir.func private @search_ints(!cir.ptr<!s32i>, !cir.ptr<!s32i>, !cir.ptr<!s32i>, !cir.ptr<!s32i>) -> !cir.ptr<!s32i> func_info<#cir.func_identity<"std::search">>
  cir.global "private" internal @wide_storage = #cir.zero : !cir.array<!s32i x 4>
  cir.global "private" internal @wide_pattern = #cir.zero : !cir.array<!s32i x 2>

  cir.global external @global_wide_hit = ctor : !cir.ptr<!s32i> {
    %0 = cir.get_global @wide_storage : !cir.ptr<!cir.array<!s32i x 4>>
    %1 = cir.cast array_to_ptrdecay %0 : !cir.ptr<!cir.array<!s32i x 4>> -> !cir.ptr<!s32i>
    %2 = cir.const #cir.int<4> : !s64i
    %3 = cir.ptr_stride %1, %2 : (!cir.ptr<!s32i>, !s64i) -> !cir.ptr<!s32i>
    %4 = cir.get_global @wide_pattern : !cir.ptr<!cir.array<!s32i x 2>>
    %5 = cir.cast array_to_ptrdecay %4 : !cir.ptr<!cir.array<!s32i x 2>> -> !cir.ptr<!s32i>
    %6 = cir.const #cir.int<2> : !s64i
    %7 = cir.ptr_stride %5, %6 : (!cir.ptr<!s32i>, !s64i) -> !cir.ptr<!s32i>
    %8 = cir.std.search(%1 : !cir.ptr<!s32i>, %3 : !cir.ptr<!s32i>, %5 : !cir.ptr<!s32i>, %7 : !cir.ptr<!s32i>, @search_ints) -> !cir.ptr<!s32i> {cir.wide_char_params}
    %9 = cir.get_global @global_wide_hit : !cir.ptr<!cir.ptr<!s32i>>
    cir.store %8, %9 : !cir.ptr<!s32i>, !cir.ptr<!cir.ptr<!s32i>>
  }
// The loop's allocas have no home in a global initializer region, so the
// wide form stays and lowers back to the call.
// CHECK-LABEL: cir.global external @global_wide_hit = ctor
// CHECK: cir.std.search
// CHECK-NOT: cir.libc.wmemchr
}

// -----

// A module that already declares wmemchr with the other signedness makes
// the candidate loop adopt that signature and cast at the call boundary.
!u32i = !cir.int<u, 32>
!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>

module attributes {cir.triple = "x86_64-unknown-linux-gnu",
                   cir.int_type_width = 32 : i32,
                   cir.size_type_width = 64 : i32,
                   cir.wchar_type_width = 32 : i32} {
  cir.func private @wmemchr(!cir.ptr<!u32i>, !u32i, !u64i) -> !cir.ptr<!u32i>
  cir.func private @search_ints(!cir.ptr<!s32i>, !cir.ptr<!s32i>, !cir.ptr<!s32i>, !cir.ptr<!s32i>) -> !cir.ptr<!s32i> func_info<#cir.func_identity<"std::search">>

  cir.func @transforms_flipped_signedness(%first1: !cir.ptr<!s32i>, %last1: !cir.ptr<!s32i>, %first2: !cir.ptr<!s32i>, %last2: !cir.ptr<!s32i>) -> !cir.ptr<!s32i> {
    %0 = cir.std.search(%first1 : !cir.ptr<!s32i>, %last1 : !cir.ptr<!s32i>, %first2 : !cir.ptr<!s32i>, %last2 : !cir.ptr<!s32i>, @search_ints) -> !cir.ptr<!s32i> {cir.wide_char_params}
    cir.return %0 : !cir.ptr<!s32i>
  }
// The null compare and the offset difference both run on the pointer cast
// back to the element type.
// CHECK-LABEL: cir.func @transforms_flipped_signedness
// CHECK: %[[FSOUGHT:.*]] = cir.cast integral %{{.*}} : !s32i -> !u32i
// CHECK: %[[FSRC:.*]] = cir.cast bitcast %{{.*}} : !cir.ptr<!s32i> -> !cir.ptr<!u32i>
// CHECK: %[[FCAND:.*]] = cir.libc.wmemchr(%[[FSRC]], %[[FSOUGHT]], %{{.*}}) : !cir.ptr<!u32i>, !u32i, !u64i
// CHECK: %[[FBACK:.*]] = cir.cast bitcast %[[FCAND]] : !cir.ptr<!u32i> -> !cir.ptr<!s32i>
// CHECK: %[[FNULL:.*]] = cir.const #cir.ptr<null> : !cir.ptr<!s32i>
// CHECK: cir.cmp eq %[[FBACK]], %[[FNULL]] : !cir.ptr<!s32i>
// CHECK: cir.ptr_diff %[[FBACK]], %{{.*}} : !cir.ptr<!s32i> -> !u64i
// CHECK-NOT: cir.std.search
}
