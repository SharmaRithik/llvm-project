                        %last1 : !cir.ptr<!u8i>,
                        %first2 : !cir.ptr<!u8i>,
                        %last2 : !cir.ptr<!u8i>,
                        @search_bytes) -> !cir.ptr<!u8i> {cir.narrow_char_params}
    cir.return %0 : !cir.ptr<!u8i>
