// -----

!u8i = !cir.int<u, 8>
!s64i = !cir.int<s, 64>

module attributes {cir.triple = "x86_64-unknown-linux-gnu",
                   cir.size_type_width = 64 : i32} {
  cir.global external @haystack = #cir.zero : !cir.array<!u8i x 8>
  cir.global external @needle = #cir.zero : !cir.array<!u8i x 2>

  cir.global external @global_result = ctor : !cir.ptr<!u8i> {
    %0 = cir.get_global @haystack : !cir.ptr<!cir.array<!u8i x 8>>
    %1 = cir.cast array_to_ptrdecay %0 : !cir.ptr<!cir.array<!u8i x 8>> -> !cir.ptr<!u8i>
    %2 = cir.const #cir.int<8> : !s64i
    %3 = cir.ptr_stride %1, %2 : (!cir.ptr<!u8i>, !s64i) -> !cir.ptr<!u8i>
    %4 = cir.get_global @needle : !cir.ptr<!cir.array<!u8i x 2>>
    %5 = cir.cast array_to_ptrdecay %4 : !cir.ptr<!cir.array<!u8i x 2>> -> !cir.ptr<!u8i>
    %6 = cir.const #cir.int<2> : !s64i
    %7 = cir.ptr_stride %5, %6 : (!cir.ptr<!u8i>, !s64i) -> !cir.ptr<!u8i>
    %8 = cir.std.search(%1 : !cir.ptr<!u8i>,
                        %3 : !cir.ptr<!u8i>,
                        %5 : !cir.ptr<!u8i>,
                        %7 : !cir.ptr<!u8i>,
                        @search_bytes) -> !cir.ptr<!u8i> {cir.narrow_char_params}
    %9 = cir.get_global @global_result : !cir.ptr<!cir.ptr<!u8i>>
    cir.store %8, %9 : !cir.ptr<!u8i>, !cir.ptr<!cir.ptr<!u8i>>
  }
// CHECK-LABEL: cir.global external @global_result = ctor
// CHECK-NOT: cir.std.search
// CHECK: cir.libc.memmem
}

// -----

!s16i = !cir.int<s, 16>

