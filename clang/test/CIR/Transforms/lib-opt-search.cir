// room for the needle, one memcmp verifies each, and a failed candidate
// resumes one element later. The memcmp length is the element count
// scaled to bytes.
// CHECK-LABEL: cir.func @transforms_wide
// CHECK-SAME: (%[[FIRST1:.*]]: !cir.ptr<!s32i>, %[[LAST1:.*]]: !cir.ptr<!s32i>, %[[FIRST2:.*]]: !cir.ptr<!s32i>, %[[LAST2:.*]]: !cir.ptr<!s32i>)
