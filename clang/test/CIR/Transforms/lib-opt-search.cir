// CHECK: %[[RES:.*]] = cir.alloca "search_result"
// CHECK: %[[ESIZE:.*]] = cir.const #cir.int<4> : !u64i
// CHECK: %[[HAYLEN:.*]] = cir.ptr_diff %[[LAST1]], %[[FIRST1]] : !cir.ptr<!s32i> -> !u64i
// CHECK: %[[NEEDLELEN:.*]] = cir.ptr_diff %[[LAST2]], %[[FIRST2]] : !cir.ptr<!s32i> -> !u64i
// CHECK: %[[NEEDLEBYTES:.*]] = cir.mul %[[NEEDLELEN]], %[[ESIZE]] : !u64i
// CHECK: cir.libc.memcmp(%{{.*}}, %{{.*}}, %[[NEEDLEBYTES]])
// CHECK: %[[SUB:.*]] = cir.sub %[[HAYLEN]], %[[NEEDLELEN]] : !u64i
// CHECK: %[[CANDS:.*]] = cir.add %[[SUB]], %{{.*}} : !u64i
// CHECK: %[[SOUGHT:.*]] = cir.load %[[FIRST2]] : !cir.ptr<!s32i>, !s32i
// CHECK: cir.while {
// CHECK: %[[OFF:.*]] = cir.load %[[SCAN]]
// CHECK: cir.cmp lt %[[OFF]], %[[CANDS]] : !u64i
// CHECK: %[[SCANPTR:.*]] = cir.ptr_stride %[[FIRST1]], %[[OFF]] : (!cir.ptr<!s32i>, !u64i) -> !cir.ptr<!s32i>
// CHECK: %[[CAND:.*]] = cir.libc.wmemchr(%[[SCANPTR]], %[[SOUGHT]], %{{.*}}) : !cir.ptr<!s32i>, !s32i, !u64i
// CHECK: cir.libc.memcmp(%{{.*}}, %{{.*}}, %[[NEEDLEBYTES]])
// CHECK: cir.store %[[CAND]], %[[RES]]
// CHECK: cir.ptr_diff %[[CAND]], %[[FIRST1]] : !cir.ptr<!s32i> -> !u64i
// CHECK: cir.load %[[RES]]
// CHECK-NOT: cir.std.search

  cir.func @keeps_wide_marker_on_wrong_width(%first1: !cir.ptr<!s16i>, %last1: !cir.ptr<!s16i>, %first2: !cir.ptr<!s16i>, %last2: !cir.ptr<!s16i>) -> !cir.ptr<!s16i> {
