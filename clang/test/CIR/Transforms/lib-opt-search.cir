  cir.func @shares_compatible_definition(
      %first1: !cir.ptr<!u8i>, %last1: !cir.ptr<!u8i>,
      %first2: !cir.ptr<!u8i>, %last2: !cir.ptr<!u8i>)
      -> !cir.ptr<!u8i> {
