module attributes {cir.triple = "x86_64-unknown-linux-gnu",
                   cir.size_type_width = 64 : i32} {
// CHECK-LABEL: cir.func @memmem(%{{.*}}: !cir.ptr<!void>, %{{.*}}: !u64i, %{{.*}}: !cir.ptr<!void>, %{{.*}}: !u64i) -> !cir.ptr<!void>
  cir.func @memmem(%haystack: !voidptr, %haystack_size: !u64i,
                   %needle: !voidptr, %needle_size: !u64i) -> !voidptr {
    cir.return %haystack : !voidptr
  }

  cir.func @shares_compatible_definition(
      %first1: !cir.ptr<!u8i>, %last1: !cir.ptr<!u8i>,
      %first2: !cir.ptr<!u8i>, %last2: !cir.ptr<!u8i>)
      -> !cir.ptr<!u8i> {
