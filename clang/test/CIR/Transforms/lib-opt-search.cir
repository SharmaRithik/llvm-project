// RUN: cir-opt --cir-lib-opt -split-input-file %s -o - | FileCheck %s

!u8i = !cir.int<u, 8>
!hayiter = !cir.struct<class "HayIter" {data !cir.ptr<!u8i>}>
!needleiter = !cir.struct<class "NeedleIter" {data !cir.ptr<!u8i>}>

module attributes {cir.triple = "x86_64-unknown-linux-gnu",
                   cir.size_type_width = 64 : i32} {
  cir.func @transforms(%first1: !cir.ptr<!u8i>, %last1: !cir.ptr<!u8i>,
                       %first2: !cir.ptr<!u8i>, %last2: !cir.ptr<!u8i>)
      -> !cir.ptr<!u8i> {
    %0 = cir.std.search(%first1 : !cir.ptr<!u8i>,
                        %last1 : !cir.ptr<!u8i>,
                        %first2 : !cir.ptr<!u8i>,
                        %last2 : !cir.ptr<!u8i>,
                        @search_bytes) -> !cir.ptr<!u8i> {cir.narrow_char_params}
    cir.return %0 : !cir.ptr<!u8i>
  }
// CHECK-LABEL: cir.func @transforms
// CHECK-SAME: (%[[FIRST1:.*]]: !cir.ptr<!u8i>, %[[LAST1:.*]]: !cir.ptr<!u8i>, %[[FIRST2:.*]]: !cir.ptr<!u8i>, %[[LAST2:.*]]: !cir.ptr<!u8i>)
// CHECK-NOT: cir.std.search
// CHECK: %[[EMPTY:.*]] = cir.cmp eq %[[FIRST2]], %[[LAST2]] : !cir.ptr<!u8i>
// CHECK: %[[RESULT:.*]] = cir.ternary(%[[EMPTY]], true {
// CHECK-NEXT: cir.yield %[[FIRST1]] : !cir.ptr<!u8i>
// CHECK-NEXT: }, false {
// CHECK-NEXT: %[[HAYLEN:.*]] = cir.ptr_diff %[[LAST1]], %[[FIRST1]] : !cir.ptr<!u8i> -> !u64i
// CHECK-NEXT: %[[NEEDLELEN:.*]] = cir.ptr_diff %[[LAST2]], %[[FIRST2]] : !cir.ptr<!u8i> -> !u64i
// CHECK-NEXT: %[[LONGER:.*]] = cir.cmp gt %[[NEEDLELEN]], %[[HAYLEN]] : !u64i
// CHECK-NEXT: %[[NONEMPTY:.*]] = cir.ternary(%[[LONGER]], true {
// CHECK-NEXT: cir.yield %[[LAST1]] : !cir.ptr<!u8i>
// CHECK-NEXT: }, false {
// CHECK: %[[HAYSTACK:.*]] = cir.cast bitcast %[[FIRST1]] : !cir.ptr<!u8i> -> !cir.ptr<!void>
// CHECK: %[[NEEDLE:.*]] = cir.cast bitcast %[[FIRST2]] : !cir.ptr<!u8i> -> !cir.ptr<!void>
// CHECK: %[[FOUND:.*]] = cir.libc.memmem(%[[HAYSTACK]], %[[HAYLEN]], %[[NEEDLE]], %[[NEEDLELEN]]) : !cir.ptr<!void>, !u64i, !cir.ptr<!void>, !u64i
// CHECK: %[[TYPED:.*]] = cir.cast bitcast %[[FOUND]] : !cir.ptr<!void> -> !cir.ptr<!u8i>
// CHECK: %[[NULL:.*]] = cir.const #cir.ptr<null> : !cir.ptr<!u8i>
// CHECK: %[[MISS:.*]] = cir.cmp eq %[[TYPED]], %[[NULL]] : !cir.ptr<!u8i>
// CHECK: %[[SELECT:.*]] = cir.select if %[[MISS]] then %[[LAST1]] else %[[TYPED]]
// CHECK-NEXT: cir.yield %[[SELECT]] : !cir.ptr<!u8i>
// CHECK-NEXT: }) : (!cir.bool) -> !cir.ptr<!u8i>
// CHECK-NEXT: cir.yield %[[NONEMPTY]] : !cir.ptr<!u8i>
// CHECK-NEXT: }) : (!cir.bool) -> !cir.ptr<!u8i>
// CHECK: cir.return %[[RESULT]] : !cir.ptr<!u8i>

  cir.func @keeps_unmarked(%first1: !cir.ptr<!u8i>,
                           %last1: !cir.ptr<!u8i>,
                           %first2: !cir.ptr<!u8i>,
                           %last2: !cir.ptr<!u8i>) -> !cir.ptr<!u8i> {
    %0 = cir.std.search(%first1 : !cir.ptr<!u8i>,
                        %last1 : !cir.ptr<!u8i>,
                        %first2 : !cir.ptr<!u8i>,
                        %last2 : !cir.ptr<!u8i>,
                        @search_bytes) -> !cir.ptr<!u8i>
    cir.return %0 : !cir.ptr<!u8i>
  }
// CHECK-LABEL: cir.func @keeps_unmarked
// CHECK: cir.std.search
// CHECK-NOT: cir.libc.memmem
  cir.func @keeps_no_builtin(%first1: !cir.ptr<!u8i>,
                             %last1: !cir.ptr<!u8i>,
                             %first2: !cir.ptr<!u8i>,
                             %last2: !cir.ptr<!u8i>) -> !cir.ptr<!u8i> {
    %0 = cir.std.search(%first1 : !cir.ptr<!u8i>,
                        %last1 : !cir.ptr<!u8i>,
                        %first2 : !cir.ptr<!u8i>,
                        %last2 : !cir.ptr<!u8i>,
                        @search_bytes) -> !cir.ptr<!u8i> {cir.narrow_char_params, nobuiltins = ["memmem"]}
    cir.return %0 : !cir.ptr<!u8i>
  }
// CHECK-LABEL: cir.func @keeps_no_builtin
// CHECK: cir.std.search
// CHECK-NOT: cir.libc.memmem

  cir.func @keeps_no_builtin_marked_call(%first1: !cir.ptr<!u8i>,
                                         %last1: !cir.ptr<!u8i>,
                                         %first2: !cir.ptr<!u8i>,
                                         %last2: !cir.ptr<!u8i>)
      -> !cir.ptr<!u8i> {
    %0 = cir.std.search(%first1 : !cir.ptr<!u8i>,
                        %last1 : !cir.ptr<!u8i>,
                        %first2 : !cir.ptr<!u8i>,
                        %last2 : !cir.ptr<!u8i>,
                        @search_bytes) -> !cir.ptr<!u8i> {cir.narrow_char_params, nobuiltin}
    cir.return %0 : !cir.ptr<!u8i>
  }
// CHECK-LABEL: cir.func @keeps_no_builtin_marked_call
// CHECK: cir.std.search
// CHECK-NOT: cir.libc.memmem

  cir.func @keeps_enclosing_no_builtin(%first1: !cir.ptr<!u8i>,
                                       %last1: !cir.ptr<!u8i>,
                                       %first2: !cir.ptr<!u8i>,
                                       %last2: !cir.ptr<!u8i>)
      -> !cir.ptr<!u8i> attributes {nobuiltins = ["memmem"]} {
    %0 = cir.std.search(%first1 : !cir.ptr<!u8i>,
                        %last1 : !cir.ptr<!u8i>,
                        %first2 : !cir.ptr<!u8i>,
                        %last2 : !cir.ptr<!u8i>,
                        @search_bytes) -> !cir.ptr<!u8i> {cir.narrow_char_params}
    cir.return %0 : !cir.ptr<!u8i>
  }
// CHECK-LABEL: cir.func @keeps_enclosing_no_builtin
// CHECK: cir.std.search
// CHECK-NOT: cir.libc.memmem

  cir.func builtin @keeps_builtin_marked_function(
      %first1: !cir.ptr<!u8i>, %last1: !cir.ptr<!u8i>,
      %first2: !cir.ptr<!u8i>, %last2: !cir.ptr<!u8i>)
      -> !cir.ptr<!u8i> attributes {nobuiltins = ["memmem"]} {
    %0 = cir.std.search(%first1 : !cir.ptr<!u8i>,
                        %last1 : !cir.ptr<!u8i>,
                        %first2 : !cir.ptr<!u8i>,
                        %last2 : !cir.ptr<!u8i>,
                        @search_bytes) -> !cir.ptr<!u8i> {cir.narrow_char_params}
    cir.return %0 : !cir.ptr<!u8i>
  }
// CHECK-LABEL: cir.func builtin @keeps_builtin_marked_function
// CHECK: cir.std.search
// CHECK-NOT: cir.libc.memmem

  cir.func @transforms_in_no_builtin_marked_function(
      %first1: !cir.ptr<!u8i>, %last1: !cir.ptr<!u8i>,
      %first2: !cir.ptr<!u8i>, %last2: !cir.ptr<!u8i>)
      -> !cir.ptr<!u8i> attributes {nobuiltin} {
    %0 = cir.std.search(%first1 : !cir.ptr<!u8i>,
                        %last1 : !cir.ptr<!u8i>,
                        %first2 : !cir.ptr<!u8i>,
                        %last2 : !cir.ptr<!u8i>,
                        @search_bytes) -> !cir.ptr<!u8i> {cir.narrow_char_params}
    cir.return %0 : !cir.ptr<!u8i>
  }
// CHECK-LABEL: cir.func @transforms_in_no_builtin_marked_function
// CHECK-NOT: cir.std.search
// CHECK: cir.libc.memmem


  cir.func @transforms_wrapped(%first1: !hayiter, %last1: !hayiter,
                               %first2: !needleiter, %last2: !needleiter)
      -> !hayiter {
    %0 = cir.std.search(%first1 : !hayiter, %last1 : !hayiter,
                        %first2 : !needleiter, %last2 : !needleiter,
                        @search_wrapped) -> !hayiter {cir.narrow_char_params}
    cir.return %0 : !hayiter
  }
// CHECK-LABEL: cir.func @transforms_wrapped
// CHECK-SAME: (%[[WFIRST1_RECORD:[^:]*]]: !rec_HayIter,
// CHECK: %[[WFIRST1:.*]] = cir.extract_member %[[WFIRST1_RECORD]][0] : !rec_HayIter -> !cir.ptr<!u8i>
// CHECK: %[[WLAST1:.*]] = cir.extract_member %{{.*}}[0] : !rec_HayIter -> !cir.ptr<!u8i>
// CHECK: %[[WFIRST2:.*]] = cir.extract_member %{{.*}}[0] : !rec_NeedleIter -> !cir.ptr<!u8i>
// CHECK: %[[WLAST2:.*]] = cir.extract_member %{{.*}}[0] : !rec_NeedleIter -> !cir.ptr<!u8i>
// CHECK: cir.cmp eq %[[WFIRST2]], %[[WLAST2]]
// CHECK: cir.libc.memmem
// CHECK: %[[WRAPPED:.*]] = cir.insert_member %[[WFIRST1_RECORD]][0], %{{.*}} : !rec_HayIter, !cir.ptr<!u8i>
// CHECK: cir.return %[[WRAPPED]] : !rec_HayIter
}

