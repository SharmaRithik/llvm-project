    %0 = cir.std.mismatch(%first1 : !cir.ptr<!s32i>, %last1 : !cir.ptr<!s32i>, %first2 : !cir.ptr<!s32i>, @_ZSt8mismatchND) -> !nowchar_pair {cir.wide_char_params}
