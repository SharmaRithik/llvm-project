}

// CHECK-LABEL: cir.func @keeps_wrong_cached_role_type
// CHECK: cir.std.find
// CHECK-NOT: cir.libc.memchr

// -----

// A module that already declares wmemchr with the other signedness makes
// the walk adopt that signature and cast at the call boundary.
!u32i = !cir.int<u, 32>
!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>
!iter = !cir.struct<class "std::__1::__deque_iterator<wchar_t>" {data !cir.ptr<!cir.ptr<!s32i>>, data !cir.ptr<!s32i>}, std_type_info = #cir.std_type_info<"std::deque_iterator", !s32i, roles {block_size = 1024 : i64, current_pointer = array<i32: 1>, map_pointer = array<i32: 0>}>>

module attributes {cir.triple = "x86_64-unknown-linux-gnu", cir.size_type_width = 64 : i32, cir.int_type_width = 32 : i32, cir.wchar_type_width = 32 : i32} {
  cir.func private @wmemchr(!cir.ptr<!u32i>, !u32i, !u64i) -> !cir.ptr<!u32i>
  cir.func private @wide_find(!iter, !iter, !cir.ptr<!s32i>) -> !iter func_info<#cir.func_identity<"std::find">>

  cir.func @transforms_flipped_signedness(%first: !iter, %last: !iter, %value: !cir.ptr<!s32i>) -> !iter {
    %0 = cir.std.find(%first : !iter, %last : !iter, %value : !cir.ptr<!s32i>, @wide_find) -> !iter {cir.wide_char_params}
    cir.return %0 : !iter
  }
}

// CHECK-LABEL: cir.func @transforms_flipped_signedness
// CHECK: %[[SRC:.*]] = cir.cast bitcast %{{.*}} : !cir.ptr<!s32i> -> !cir.ptr<!u32i>
// CHECK: cir.libc.wmemchr(%[[SRC]], %{{.*}}, %{{.*}})
// CHECK-NOT: cir.std.find

