!s16i = !cir.int<s, 16>
!iter = !cir.struct<class "std::__1::__deque_iterator<short>" {data !cir.ptr<!cir.ptr<!s16i>>, data !cir.ptr<!s16i>}, std_type_info = #cir.std_type_info<"std::deque_iterator", !s16i, roles {block_size = 2048 : i64, current_pointer = array<i32: 1>, map_pointer = array<i32: 0>}>>

module attributes {cir.triple = "x86_64-unknown-linux-gnu", cir.size_type_width = 64 : i32, cir.int_type_width = 32 : i32, cir.wchar_type_width = 32 : i32} {
  cir.func private @find(!iter, !iter, !cir.ptr<!s16i>) -> !iter func_info<#cir.func_identity<"std::find">>

  cir.func @keeps_non_character(%first: !iter, %last: !iter, %value: !cir.ptr<!s16i>) -> !iter {
    %0 = cir.std.find(%first : !iter, %last : !iter, %value : !cir.ptr<!s16i>, @find) -> !iter {cir.narrow_char_params}
    cir.return %0 : !iter
  }
}

// CHECK-LABEL: cir.func @keeps_non_character
// CHECK: cir.std.find
// CHECK-NOT: cir.libc.memchr
