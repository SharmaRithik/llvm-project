// -----

// An identity whose roles name fewer members than the record holds would
// leave stale cached bounds in the rebuilt hit iterator, so the rewrite
// declines it.
!s8i = !cir.int<s, 8>
!iter = !cir.struct<class "undercovering" {data !cir.ptr<!s8i>, data !cir.ptr<!s8i>, data !cir.ptr<!s8i>, data !cir.ptr<!cir.ptr<!s8i>>}, std_type_info = #cir.std_type_info<"std::deque_iterator", !s8i, roles {block_size = 512 : i64, current_pointer = array<i32: 0>, map_pointer = array<i32: 3>}>>

module attributes {cir.triple = "x86_64-unknown-linux-gnu", cir.size_type_width = 64 : i32, cir.int_type_width = 32 : i32} {
  cir.func private @find(!iter, !iter, !cir.ptr<!s8i>) -> !iter func_info<#cir.func_identity<"std::find">>

  cir.func @keeps_undercovering_identity(%first: !iter, %last: !iter, %value: !cir.ptr<!s8i>) -> !iter {
    %0 = cir.std.find(%first : !iter, %last : !iter, %value : !cir.ptr<!s8i>, @find) -> !iter {cir.narrow_char_params}
    cir.return %0 : !iter
  }
}

// CHECK-LABEL: cir.func @keeps_undercovering_identity
// CHECK: cir.std.find
// CHECK-NOT: cir.libc.memchr

// -----

// Overlapping role paths would let the cached bound refresh clobber the
// hit current pointer, so the rewrite declines them.
!s8i = !cir.int<s, 8>
!iter = !cir.struct<class "overlapping" {data !cir.ptr<!s8i>, data !cir.ptr<!s8i>, data !cir.ptr<!s8i>, data !cir.ptr<!cir.ptr<!s8i>>}, std_type_info = #cir.std_type_info<"std::deque_iterator", !s8i, roles {block_first_pointer = array<i32: 0>, block_last_pointer = array<i32: 2>, block_size = 512 : i64, current_pointer = array<i32: 0>, map_pointer = array<i32: 3>}>>

module attributes {cir.triple = "x86_64-unknown-linux-gnu", cir.size_type_width = 64 : i32, cir.int_type_width = 32 : i32} {
  cir.func private @find(!iter, !iter, !cir.ptr<!s8i>) -> !iter func_info<#cir.func_identity<"std::find">>

  cir.func @keeps_overlapping_roles(%first: !iter, %last: !iter, %value: !cir.ptr<!s8i>) -> !iter {
    %0 = cir.std.find(%first : !iter, %last : !iter, %value : !cir.ptr<!s8i>, @find) -> !iter {cir.narrow_char_params}
    cir.return %0 : !iter
  }
}

// CHECK-LABEL: cir.func @keeps_overlapping_roles
// CHECK: cir.std.find
// CHECK-NOT: cir.libc.memchr

// -----

!s8i = !cir.int<s, 8>
!iter = !cir.struct<class "wrong_cached_type" {data !cir.ptr<!s8i>, data !cir.ptr<!cir.ptr<!s8i>>, data !cir.ptr<!s8i>, data !cir.ptr<!cir.ptr<!s8i>>}, std_type_info = #cir.std_type_info<"std::deque_iterator", !s8i, roles {block_first_pointer = array<i32: 1>, block_last_pointer = array<i32: 2>, block_size = 512 : i64, current_pointer = array<i32: 0>, map_pointer = array<i32: 3>}>>

module attributes {cir.triple = "x86_64-unknown-linux-gnu", cir.size_type_width = 64 : i32, cir.int_type_width = 32 : i32} {
  cir.func private @find(!iter, !iter, !cir.ptr<!s8i>) -> !iter func_info<#cir.func_identity<"std::find">>

  cir.func @keeps_wrong_cached_role_type(%first: !iter, %last: !iter, %value: !cir.ptr<!s8i>) -> !iter {
    %0 = cir.std.find(%first : !iter, %last : !iter, %value : !cir.ptr<!s8i>, @find) -> !iter {cir.narrow_char_params}
