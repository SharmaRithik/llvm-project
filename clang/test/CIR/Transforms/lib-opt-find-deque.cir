!s8i = !cir.int<s, 8>

!iter = !cir.struct<class "std::__1::__deque_iterator<char>" {data !cir.ptr<!cir.ptr<!s8i>>, data !cir.ptr<!s8i>}, std_type_info = #cir.std_type_info<"std::deque_iterator", !s8i, roles {block_size = 4096 : i64, current_pointer = array<i32: 1>, map_pointer = array<i32: 0>}>>
!closure = !cir.struct<class "Closure" {data !cir.ptr<!s8i>}>

module attributes {cir.triple = "x86_64-unknown-linux-gnu", cir.size_type_width = 64 : i32, cir.int_type_width = 32 : i32} {
  cir.func private @find_if(!iter, !iter, !closure) -> !iter func_info<#cir.func_identity<"std::find_if">>

  cir.func @transforms_find_if(%first: !iter, %last: !iter, %pred: !closure) -> !iter {
    %0 = cir.std.find_if(%first : !iter, %last : !iter, %pred : !closure, @find_if) -> !iter {cir.byte_eq_pred}
    cir.return %0 : !iter
  }
}

// CHECK-LABEL: cir.func @transforms_find_if
// CHECK: %[[CAPTURE:.*]] = cir.extract_member %arg2[0]
// CHECK: %[[SOUGHT:.*]] = cir.load %[[CAPTURE]]
// CHECK: cir.libc.memchr({{.*}}, %{{.*}}, %{{.*}})
// CHECK: cir.while {
// CHECK-NOT: cir.std.find_if

