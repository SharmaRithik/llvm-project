// RUN: cir-opt --cir-to-llvm %s 2>&1 | FileCheck %s --implicit-check-not=error

!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>
!void = !cir.void

module attributes {cir.int_type_width = 32 : i32,
                   cir.size_type_width = 64 : i32} {
  cir.func @f(%src: !cir.ptr<!void>, %pat: !s32i, %len: !u64i) -> !cir.ptr<!void> {
    %0 = cir.libc.memchr(%src, %pat, %len) : !cir.ptr<!void>, !s32i, !u64i
    cir.return %0 : !cir.ptr<!void>
  }
// CHECK-LABEL: @f
// CHECK: llvm.call @memchr(%{{.*}}, %{{.*}}, %{{.*}})
// CHECK-NOT: llvm.signext
}
