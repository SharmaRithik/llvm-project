// RUN: cir-opt --cir-to-llvm %s 2>&1 | FileCheck %s --implicit-check-not=error

!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>
!void = !cir.void

module attributes {cir.int_type_width = 32 : i32,
                   cir.wchar_type_width = 32 : i32,
                   cir.size_type_width = 64 : i32} {
  cir.func @f(%src: !cir.ptr<!void>, %pat: !s32i, %len: !u64i) -> !cir.ptr<!void> {
    %0 = cir.libc.memchr(%src, %pat, %len) : !cir.ptr<!void>, !s32i, !u64i
    cir.return %0 : !cir.ptr<!void>
  }
// CHECK-LABEL: @f
// CHECK: llvm.call @memchr(%{{.*}}, %{{.*}}, %{{.*}})
// CHECK-NOT: llvm.signext

  cir.func @g(%src: !cir.ptr<!s32i>, %pat: !s32i, %len: !u64i) -> !cir.ptr<!s32i> {
    %0 = cir.libc.wmemchr(%src, %pat, %len) : !cir.ptr<!s32i>, !s32i, !u64i
    cir.return %0 : !cir.ptr<!s32i>
  }
// CHECK-LABEL: @g
// CHECK: llvm.call @wmemchr(%{{.*}}, %{{.*}}, %{{.*}})
// CHECK-NOT: llvm.signext

  cir.func @h(%haystack: !cir.ptr<!void>, %haystack_len: !u64i,
              %needle: !cir.ptr<!void>, %needle_len: !u64i)
      -> !cir.ptr<!void> {
    %0 = cir.libc.memmem(%haystack, %haystack_len, %needle, %needle_len) : !cir.ptr<!void>, !u64i, !cir.ptr<!void>, !u64i
    cir.return %0 : !cir.ptr<!void>
  }
// CHECK-LABEL: @h
// CHECK: llvm.call @memmem(%{{.*}}, %{{.*}}, %{{.*}}, %{{.*}})
// CHECK-NOT: llvm.signext
// CHECK-NOT: llvm.zeroext
}
