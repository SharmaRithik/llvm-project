// RUN: cir-opt %s --cir-to-llvm | FileCheck %s --implicit-check-not=trivially_equality_comparable_params

!s8i = !cir.int<s, 8>

module attributes {cir.triple = "x86_64-unknown-linux-gnu"} {
  cir.func private @g(!cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!s8i>) -> !cir.ptr<!s8i>

  cir.func @caller(%a: !cir.ptr<!s8i>, %b: !cir.ptr<!s8i>, %v: !cir.ptr<!s8i>) -> !cir.ptr<!s8i> {
    %r = cir.call @g(%a, %b, %v) {cir.trivially_equality_comparable_params} : (!cir.ptr<!s8i>, !cir.ptr<!s8i>, !cir.ptr<!s8i>) -> !cir.ptr<!s8i>
    cir.return %r : !cir.ptr<!s8i>
  }
}

// CHECK: llvm.call @g(%{{.*}}, %{{.*}}, %{{.*}}) : (!llvm.ptr, !llvm.ptr, !llvm.ptr) -> !llvm.ptr
