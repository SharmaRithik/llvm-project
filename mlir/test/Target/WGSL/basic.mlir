// RUN: mlir-translate --mlir-to-wgsl %s | FileCheck %s

// Kernel arguments become resource variables; the uniform is packed into
// 16-byte vectors as WGSL requires.
// CHECK:      // Generated by mlir-translate --mlir-to-wgsl.
// CHECK-NEXT: enable f16;
// CHECK-EMPTY:
// CHECK-NEXT: @group(0) @binding(0) var<storage, read> a: array<f16>;
// CHECK-NEXT: @group(0) @binding(1) var<storage, read_write> b: array<f32>;
// CHECK-NEXT: @group(1) @binding(5) var<uniform> params: array<vec4<u32>, 2>;
// CHECK-EMPTY:
// CHECK-NEXT: @compute @workgroup_size(64, 1, 1)
// CHECK-NEXT: fn main(@builtin(local_invocation_id) local_id: vec3<u32>, @builtin(workgroup_id) wg_id: vec3<u32>) {
// CHECK-NEXT:   let [[BASE:v[0-9]+]]: u32 = wg_id.x * 64u;
// CHECK-NEXT:   let [[I:v[0-9]+]]: u32 = [[BASE]] + local_id.x;
// CHECK-NEXT:   let [[N:v[0-9]+]]: u32 = params[1u].y;
// CHECK-NEXT:   let [[OFF:v[0-9]+]]: u32 = params[([[I]]) / 4u][([[I]]) % 4u];
// CHECK-NEXT:   let [[INB:v[0-9]+]]: bool = [[I]] < [[N]];
// CHECK-NEXT:   if ([[INB]]) {
// CHECK-NEXT:     let [[X:v[0-9]+]]: f16 = a[[[I]]];
// CHECK-NEXT:     let [[XF:v[0-9]+]]: f32 = f32([[X]]);
// CHECK-NEXT:     let [[Y:v[0-9]+]]: f32 = fma([[XF]], 2.5f, (-0.125f));
// CHECK-NEXT:     let [[J:v[0-9]+]]: u32 = [[I]] + [[OFF]];
// CHECK-NEXT:     b[[[J]]] = [[Y]];
// CHECK-NEXT:   }
// CHECK-NEXT:   return;
// CHECK-NEXT: }
module attributes {gpu.container_module} {
  gpu.module @kernels {
    gpu.func @main(%a: memref<?xf16> {wgsl.name = "a", wgsl.access = "read"},
                   %b: memref<?xf32> {wgsl.name = "b"},
                   %p: memref<8xi32> {wgsl.name = "params", wgsl.group = 1 : i32,
                                      wgsl.binding = 5 : i32, wgsl.address_space = "uniform"})
        kernel attributes {known_block_size = array<i32: 64, 1, 1>} {
      %tid = gpu.thread_id x
      %bid = gpu.block_id x
      %c64 = arith.constant 64 : index
      %base = arith.muli %bid, %c64 : index
      %i = arith.addi %base, %tid : index
      %c5 = arith.constant 5 : index
      %n32 = memref.load %p[%c5] : memref<8xi32>
      %n = arith.index_cast %n32 : i32 to index
      %off32 = memref.load %p[%i] : memref<8xi32>
      %off = arith.index_castui %off32 : i32 to index
      %inb = arith.cmpi ult, %i, %n : index
      scf.if %inb {
        %x = memref.load %a[%i] : memref<?xf16>
        %xf = arith.extf %x : f16 to f32
        %two = arith.constant 2.5 : f32
        %eps = arith.constant -0.125 : f32
        %y = math.fma %xf, %two, %eps : f32
        %j = arith.addi %i, %off : index
        memref.store %y, %b[%j] : memref<?xf32>
      }
      gpu.return
    }
  }
}
